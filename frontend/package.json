{
  "name": "tf2025-frontend",
  "version": "1.0.0",
  "description": "Frontend for TF2025 project with Vue 3 + TypeScript",
  "scripts": {
    "predev": "npm run check:standards",
    "dev": "vite",
    "dev:server": "vite",
    "cert:local": "bash scripts/generate-local-https-cert.sh",
    "check:data-freshness": "node scripts/check-data-freshness.mjs",
    "check:payment-methods": "node scripts/check-payment-methods.mjs",
    "check:fields": "node scripts/check-field-consistency.mjs",
    "check:field-permissions": "node scripts/check-field-permission-coverage.mjs",
    "check:lint": "cd .. && npm run lint:check",
    "check:coverage": "node scripts/check-standards-coverage.mjs",
    "check:standards-preview": "node scripts/check-standards-preview.mjs",
    "check:time": "node scripts/check-time-usage.mjs",
    "check:responsive": "node scripts/check-responsive-breakpoints.mjs",
    "check:typography": "node scripts/check-typography-standards.mjs",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:motion": "node scripts/check-motion-standards.mjs",
    "check:print": "node scripts/check-print-standards.mjs",
    "check:icons": "node scripts/check-icon-standards.mjs",
    "check:basic-components": "node scripts/check-basic-components.mjs",
    "check:drawers": "node scripts/check-drawer-standards.mjs",
    "check:shortcuts": "node scripts/check-shortcut-standards.mjs",
    "check:telemetry": "node scripts/check-telemetry-standards.mjs",
    "check:theme": "node scripts/check-theme-standards.mjs",
    "check:interactions": "node scripts/check-interaction-standards.mjs",
    "check:form-controls": "node scripts/check-form-controls.mjs",
    "check:permissions": "node scripts/check-permission-capabilities.mjs",
    "check:ui": "node scripts/check-ui-shells.mjs",
    "check:navigation": "node scripts/check-navigation-styles.mjs",
    "check:buttons": "node scripts/check-button-styles.mjs",
    "check:tables": "node scripts/check-table-layouts.mjs",
    "check:tabs": "node scripts/check-tab-styles.mjs",
    "check:loading": "node scripts/check-loading-patterns.mjs",
    "check:empty-states": "node scripts/check-empty-states.mjs",
    "check:component-adoption": "node scripts/check-component-adoption.mjs",
    "check:reference-adoption": "node scripts/check-reference-adoption.mjs",
    "check:dialogs": "node scripts/check-dialog-adoption.mjs",
    "check:dialog-actions": "node scripts/check-dialog-actions.mjs",
    "check:backend-security": "node --test scripts/check-backend-security.test.mjs && node scripts/check-backend-security.mjs",
    "check:runtime-patterns": "node scripts/check-runtime-patterns.mjs",
    "check:style-debt": "node scripts/check-style-debt.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:dependencies": "npm audit --audit-level=high && npm --prefix ../backend audit --audit-level=high && npm --prefix .. audit --audit-level=high",
    "type-check": "vue-tsc --noEmit",
    "check:standards": "npm run check:coverage && npm run check:standards-preview && npm run check:time && npm run check:responsive && npm run check:typography && npm run check:design-tokens && npm run check:motion && npm run check:print && npm run check:icons && npm run check:basic-components && npm run check:drawers && npm run check:shortcuts && npm run check:telemetry && npm run check:theme && npm run check:interactions && npm run check:form-controls && npm run check:component-adoption && npm run check:reference-adoption && npm run check:dialogs && npm run check:dialog-actions && npm run type-check && npm run check:backend-security && npm run check:runtime-patterns && npm run check:style-debt && npm run check:fields && npm run check:lint && npm run check:permissions && npm run check:ui && npm run check:navigation && npm run check:tabs && npm run check:buttons && npm run check:tables && npm run check:loading && npm run check:empty-states && npm run check:data-freshness && npm run check:payment-methods",
    "check:release": "npm run check:standards && npm run check:dependencies",
    "prebuild": "npm run check:standards",
    "build": "vite build && npm run check:bundle-size",
    "prebuild:debug": "npm run check:standards",
    "build:debug": "vite build --config vite.config.debug.ts && npm run check:bundle-size",
    "serve": "vite preview",
    "prestart": "npm run check:standards",
    "start": "vite"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/dompurify": "^3.0.5",
    "@types/sortablejs": "^1.15.8",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-vue": "^5.1.12",
    "@zxing/library": "^0.21.3",
    "aos": "^3.0.0-beta.6",
    "axios": "^1.4.0",
    "dompurify": "^3.4.12",
    "echarts": "^6.1.0",
    "element-plus": "^2.11.8",
    "heic2any": "^0.0.4",
    "html2canvas": "^1.4.1",
    "pdfjs-dist": "^5.5.207",
    "pinia": "^3.0.4",
    "sortablejs": "^1.14.0",
    "swiper": "^12.1.2",
    "v3-infinite-loading": "^1.3.2",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0",
    "vuedraggable": "^4.1.0",
    "zxing-wasm": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vue": "^1.0.31",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/tsconfig": "^0.8.1",
    "sass": "^1.97.3",
    "terser": "^5.46.1",
    "typescript": "^5.0.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^3.3.8"
  }
}
