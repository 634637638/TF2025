# 生产环境配置
VITE_NODE_ENV=production
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=15000
# 后端服务器地址（用于图片等静态资源访问）
# 默认前端和后端由同一域名代理：
#   /api     -> 后端 API
#   /uploads -> 后端上传资源
# 此时保持 VITE_API_BASE_URL=/api，VITE_BACKEND_URL 留空即可。
#
# 如果前后端不在同一个服务器，且前端服务器没有代理后端：
#   VITE_API_BASE_URL=https://api.example.com/api
#   VITE_BACKEND_URL=https://api.example.com
VITE_BACKEND_URL=
VITE_TENCENT_MAP_KEY=
VITE_API_LOGGING=false
