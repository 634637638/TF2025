{
  "name": "tf2025",
  "version": "1.0.0",
  "description": "TF2025 Fullstack Project",
  "scripts": {
    "dev": "node scripts/fix-ports.js",
    "dev:raw": "npm run check:standards && concurrently --names \"BACKEND,FRONTEND\" --prefix name \"npm run backend\" \"npm run frontend:raw\"",
    "dev:all": "node scripts/fix-ports.js",
    "dev:fixed": "node scripts/fix-ports.js",
    "backend": "cd backend && npm run dev",
    "frontend": "npm run check:standards && npm run frontend:raw",
    "frontend:raw": "cd frontend && npm run dev:server",
    "check:standards": "npm --prefix frontend run check:standards",
    "start": "node scripts/fix-ports.js",
    "start:fixed": "node scripts/fix-ports.js",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "stop": "node scripts/stop-ports.js",
    "check-ports": "node scripts/check-ports.js",
    "lint": "eslint frontend/src backend/src",
    "lint:check": "eslint frontend/src backend/src --quiet",
    "lint:frontend": "eslint frontend/src",
    "lint:backend": "eslint backend/src",
    "lint:summary": "node scripts/lint-summary.mjs",
    "lint:strict": "eslint frontend/src backend/src --max-warnings 0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.10.0"
  }
}
