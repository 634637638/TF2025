{
  "name": "tf2025-backend",
  "version": "1.0.0",
  "description": "Backend for TF2025 project",
  "main": "server.js",
  "scripts": {
    "prestart": "node scripts/check-runtime-assets.js",
    "start": "node server.js",
    "check:runtime-assets": "node scripts/check-runtime-assets.js",
    "migrate:subsidy-photos": "node scripts/migrate-subsidy-photos.js",
    "migrate:phone-media": "node scripts/migrate-phone-media.js",
    "migrate:shop-media": "node scripts/migrate-shop-media.js",
    "dev": "nodemon server.js",
    "test": "node --test test/**/*.check.js",
    "test:db": "RUN_DB_TESTS=true node --test test/**/*.check.js"
  },
  "nodemonConfig": {
    "ignore": [
      "backups/**",
      "logs/**"
    ]
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "json5": "^2.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.15.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.5.207",
    "pg": "^8.16.3",
    "puppeteer": "^25.8.0",
    "redis": "^5.10.0",
    "sharp": "^0.35.3",
    "tesseract.js": "^7.0.0",
    "validator": "^13.15.23",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
