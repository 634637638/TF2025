# 数据库配置
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_CONNECTION_LIMIT=10

# 所有密钥至少 32 字符，推荐使用 64 字节随机值（128 个十六进制字符）。
# 环境变量不会实时热更新；安全修改后只需重启后端，前端无需重新构建。
# [TF2025:JWT_SECRET] 访问令牌当前签名密钥；使用 rotate:signing-key --scope=jwt-access 平滑轮换，禁止直接覆盖。
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long_use_crypto_random_bytes
# [TF2025:JWT_PREVIOUS_SECRET] 访问令牌上一密钥，仅用于兼容旧 Token；保留最长 30 天后清空并重启后端。
JWT_PREVIOUS_SECRET=
JWT_EXPIRES_IN=24h

# [TF2025:JWT_REFRESH_SECRET] 刷新令牌当前签名密钥；使用 rotate:signing-key --scope=jwt-refresh 平滑轮换。
JWT_REFRESH_SECRET=
# [TF2025:JWT_REFRESH_PREVIOUS_SECRET] 刷新令牌上一密钥，仅验证旧 Token；保留默认 30 天后清空并重启后端。
JWT_REFRESH_PREVIOUS_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# [TF2025:CONFIG_ENCRYPTION_KEY] 支付配置当前加密密钥；禁止直接覆盖，轮换后必须执行 migrate:config-encryption-key。
CONFIG_ENCRYPTION_KEY=
# [TF2025:CONFIG_ENCRYPTION_PREVIOUS_KEY] 支付配置上一加密密钥，仅用于迁移期读取和回滚；迁移验证完成后再清空。
CONFIG_ENCRYPTION_PREVIOUS_KEY=

# [TF2025:PRICE_SYNC_ENCRYPTION_KEY] 价格同步密码加密密钥；禁止直接覆盖，必须使用 rotate:price-sync-encryption-key。
PRICE_SYNC_ENCRYPTION_KEY=

# [TF2025:FILE_ACCESS_SIGNING_KEY] 私有文件与分享附件当前签名密钥；使用 --scope=file-access 平滑轮换。
FILE_ACCESS_SIGNING_KEY=
# [TF2025:FILE_ACCESS_PREVIOUS_SIGNING_KEY] 文件签名上一密钥，仅兼容旧链接；至少保留 10 分钟后清空。
FILE_ACCESS_PREVIOUS_SIGNING_KEY=
# [TF2025:ORDER_ACCESS_SIGNING_KEY] 访客订单访问凭证当前签名密钥；使用 --scope=order-access 平滑轮换。
ORDER_ACCESS_SIGNING_KEY=
# [TF2025:ORDER_ACCESS_PREVIOUS_SIGNING_KEY] 订单访问上一密钥，仅兼容旧凭证；至少保留 24 小时后清空。
ORDER_ACCESS_PREVIOUS_SIGNING_KEY=
# [TF2025:INVENTORY_QUERY_SIGNING_KEY] 库存查询临时凭证当前签名密钥；使用 --scope=inventory-query 平滑轮换。
INVENTORY_QUERY_SIGNING_KEY=
# [TF2025:INVENTORY_QUERY_PREVIOUS_SIGNING_KEY] 库存查询上一密钥，仅兼容旧凭证；至少保留 10 分钟后清空。
INVENTORY_QUERY_PREVIOUS_SIGNING_KEY=

ALLOWED_ORIGINS=https://your-frontend-domain.example
# JWT黑名单使用数据库持久化（true）或内存存储（false）
JWT_BLACKLIST_PERSIST=true
# 开发环境初始化管理员时可指定强密码；留空则自动生成一次性强密码
INIT_ADMIN_PASSWORD=
# 管理员初始化接口默认关闭；仅在本地开发且明确需要时设置为 true
ENABLE_DEV_INIT_ADMIN=false
# 仅用于演示环境的模拟分析接口，业务环境必须保持 false
ENABLE_MOCK_ROUTES=false

# 服务器配置
PORT=3000
NODE_ENV=development

# 日志配置
LOG_LEVEL=info

# API配置
# 全局限流仅统计失败和写入请求；成功读取请求不会消耗额度。
API_RATE_LIMIT=3000
API_RATE_WINDOW_MS=900000

# 安全配置
BCRYPT_ROUNDS=12
# [TF2025:SESSION_SECRET] 预留服务端 Session 密钥；当前未启用 express-session，修改后仍需重启后端。
SESSION_SECRET=your_session_secret_key

# 缓存配置
CACHE_TTL=600
CACHE_MAX_KEYS=1000
