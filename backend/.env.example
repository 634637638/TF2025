# 数据库配置
DB_HOST=your_database_host
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_CONNECTION_LIMIT=10

# JWT配置
# ⚠️ 重要：请使用强随机密钥（至少64字符）
# 生成命令：node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long_use_crypto_random_bytes
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
# JWT黑名单使用数据库持久化（true）或内存存储（false）
JWT_BLACKLIST_PERSIST=true
# 开发环境初始化管理员时可指定强密码；留空则自动生成一次性强密码
INIT_ADMIN_PASSWORD=
# 管理员初始化接口默认关闭；仅在本地开发且明确需要时设置为 true
ENABLE_DEV_INIT_ADMIN=false
# 仅用于演示环境的模拟分析接口，业务环境必须保持 false
ENABLE_MOCK_ROUTES=false

# 服务器配置
PORT=3000
NODE_ENV=development

# 日志配置
LOG_LEVEL=info

# API配置
# 全局限流仅统计失败和写入请求；成功读取请求不会消耗额度。
API_RATE_LIMIT=3000
API_RATE_WINDOW_MS=900000

# 安全配置
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_key

# 缓存配置
CACHE_TTL=600
CACHE_MAX_KEYS=1000
