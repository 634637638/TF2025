{
  "decimal": "^-?(?:\\d+(?:\\.\\d+)?|\\.\\d+)$(?![\\s\\S])",
  "integer": "^-?\\d+$(?![\\s\\S])",
  "mobile": "^1[3-9]\\d{9}$(?![\\s\\S])",
  "phoneSeparators": "[ -]",
  "mobileCountryPrefix": "^(?:\\+86|0086|86)(?=1[3-9]\\d{9}$(?![\\s\\S]))",
  "singleLineControls": "[\\u0000-\\u001f\\u007f]",
  "multilineControls": "[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]",
  "money": "^-?\\d+(?:\\.\\d{1,2})?$(?![\\s\\S])",
  "phoneSerial": "^[A-Z0-9](?:[A-Z0-9]|[/-](?=[A-Z0-9])){3,49}$(?![\\s\\S])",
  "imei": "^\\d{15}$(?![\\s\\S])"
}
